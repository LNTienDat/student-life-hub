generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model NguoiDung {
  id          Int       @id @default(autoincrement())
  email       String    @unique
  matKhau     String
  ten         String
  avatar      String?
  truong      String?
  nganh       String?
  khoaHoc     String?
  ngayTao     DateTime  @default(now())

  resetPasswordToken  String?
  resetPasswordExpiry DateTime?

  monHocs     MonHoc[]
  deadlines   Deadline[]
  giaoDichs   GiaoDich[]
  nganSachs   NganSach[]
  thoiKhoaBieus ThoiKhoaBieu[]
}

model MonHoc {
  id          Int       @id @default(autoincrement())
  idNguoiDung Int
  ten         String
  tinChi      Int
  hocKy       String
  trangThai   String    @default("active")
  ngayTao     DateTime  @default(now())

  nguoiDung   NguoiDung @relation(fields: [idNguoiDung], references: [id], onDelete: Cascade)
  diems       Diem[]
  deadlines   Deadline[]

  @@index([idNguoiDung])
}

model Diem {
  id          Int       @id @default(autoincrement())
  idMonHoc    Int
  loaiDanhGia String
  diem        Float
  trongSo     Float
  ngayGhiNhan DateTime  @default(now())

  monHoc      MonHoc    @relation(fields: [idMonHoc], references: [id], onDelete: Cascade)

  @@index([idMonHoc])
}

model Deadline {
  id          Int       @id @default(autoincrement())
  idNguoiDung Int
  idMonHoc    Int?
  tieuDe      String
  moTa        String?
  hanChot     DateTime
  doUuTien    String    @default("binh_thuong")
  trangThai   String    @default("dang_dien_hanh")
  ngayTao     DateTime  @default(now())

  nguoiDung   NguoiDung @relation(fields: [idNguoiDung], references: [id], onDelete: Cascade)
  monHoc      MonHoc?   @relation(fields: [idMonHoc], references: [id], onDelete: SetNull)

  @@index([idNguoiDung])
  @@index([idNguoiDung, hanChot])
}

model GiaoDich {
  id          Int       @id @default(autoincrement())
  idNguoiDung Int
  loai        String
  danhMuc     String
  soTien      Float
  moTa        String?
  ngayGiaoDich DateTime @default(now())

  nguoiDung   NguoiDung @relation(fields: [idNguoiDung], references: [id], onDelete: Cascade)

  @@index([idNguoiDung])
  @@index([idNguoiDung, ngayGiaoDich])
}

model NganSach {
  id            Int       @id @default(autoincrement())
  idNguoiDung   Int
  danhMuc       String
  soTienToiDa   Float
  thang         Int
  nam           Int
  ngayTao       DateTime  @default(now())

  nguoiDung     NguoiDung @relation(fields: [idNguoiDung], references: [id], onDelete: Cascade)

  @@index([idNguoiDung])
  @@index([idNguoiDung, thang, nam])
}

model ThoiKhoaBieu {
  id          Int       @id @default(autoincrement())
  idNguoiDung Int
  tenMon      String
  thu         Int       // 2=Thứ 2 ... 7=Thứ 7, 8=Chủ nhật
  gioBatDau   String    // "07:00"
  gioKetThuc  String    // "09:00"
  phongHoc    String?
  giangVien   String?
  ngayTao     DateTime  @default(now())

  nguoiDung   NguoiDung @relation(fields: [idNguoiDung], references: [id], onDelete: Cascade)

  @@index([idNguoiDung])
}