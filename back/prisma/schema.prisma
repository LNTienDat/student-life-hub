generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model NguoiDung {
  id          Int       @id @default(autoincrement())
  email       String    @unique
  matKhau     String
  ten         String
  avatar      String?
  truong      String?
  nganh       String?
  khoaHoc     String?
  ngayTao     DateTime  @default(now())
  matKhauDoiLuc DateTime @default(now())

  resetPasswordToken  String?
  resetPasswordExpiry DateTime?

  shareToken          String?   @unique
  shareEnabled        Boolean   @default(false)

  monHocs             MonHoc[]
  deadlines           Deadline[]
  giaoDichs           GiaoDich[]
  nganSachs           NganSach[]
  thoiKhoaBieus       ThoiKhoaBieu[]
  nhomChuNhom         NhomHocTap[]        @relation("ChuNhom")
  nhomThamGia         ThanhVienNhom[]
  deadlineNhomsTao    DeadlineNhom[]      @relation("NguoiTaoDeadlineNhom")
  tienDoDeadlineNhoms TienDoDeadlineNhom[]
}

model MonHoc {
  id          Int       @id @default(autoincrement())
  idNguoiDung Int
  ten         String
  tinChi      Int
  hocKy       String
  trangThai   String    @default("active")
  ngayTao     DateTime  @default(now())

  nguoiDung   NguoiDung @relation(fields: [idNguoiDung], references: [id], onDelete: Cascade)
  diems       Diem[]
  deadlines   Deadline[]

  @@index([idNguoiDung])
  @@index([idNguoiDung, hocKy])
}

model Diem {
  id          Int       @id @default(autoincrement())
  idMonHoc    Int
  loaiDanhGia String
  diem        Float
  trongSo     Float
  ngayGhiNhan DateTime  @default(now())

  monHoc      MonHoc    @relation(fields: [idMonHoc], references: [id], onDelete: Cascade)

  @@index([idMonHoc])
}

model Deadline {
  id          Int       @id @default(autoincrement())
  idNguoiDung Int
  idMonHoc    Int?
  tieuDe      String
  moTa        String?
  hanChot     DateTime
  doUuTien    String    @default("binh_thuong")
  trangThai   String    @default("dang_dien_hanh")
  ngayTao     DateTime  @default(now())
  checklist   Json      @default("[]")

  nguoiDung   NguoiDung @relation(fields: [idNguoiDung], references: [id], onDelete: Cascade)
  monHoc      MonHoc?   @relation(fields: [idMonHoc], references: [id], onDelete: SetNull)

  @@index([idNguoiDung])
  @@index([idNguoiDung, hanChot])
  @@index([idMonHoc])
  @@index([idNguoiDung, trangThai, hanChot])
}

model GiaoDich {
  id          Int       @id @default(autoincrement())
  idNguoiDung Int
  loai        String
  danhMuc     String
  soTien      Float
  moTa        String?
  ngayGiaoDich DateTime @default(now())

  nguoiDung   NguoiDung @relation(fields: [idNguoiDung], references: [id], onDelete: Cascade)

  @@index([idNguoiDung])
  @@index([idNguoiDung, ngayGiaoDich])
}

model NganSach {
  id            Int       @id @default(autoincrement())
  idNguoiDung   Int
  danhMuc       String
  soTienToiDa   Float
  thang         Int
  nam           Int
  ngayTao       DateTime  @default(now())

  nguoiDung     NguoiDung @relation(fields: [idNguoiDung], references: [id], onDelete: Cascade)

  @@unique([idNguoiDung, danhMuc, thang, nam])
  @@index([idNguoiDung])
  @@index([idNguoiDung, thang, nam])
}

model ThoiKhoaBieu {
  id          Int       @id @default(autoincrement())
  idNguoiDung Int
  tenMon      String
  thu         Int       // 2=Thứ 2 ... 7=Thứ 7, 8=Chủ nhật
  gioBatDau   String    // "07:00"
  gioKetThuc  String    // "09:00"
  phongHoc    String?
  giangVien   String?
  hocKy       String    @default("")
  ngayTao     DateTime  @default(now())

  nguoiDung   NguoiDung @relation(fields: [idNguoiDung], references: [id], onDelete: Cascade)

  @@index([idNguoiDung])
  @@index([idNguoiDung, thu])
  @@index([idNguoiDung, hocKy])
}

model NhomHocTap {
  id          Int             @id @default(autoincrement())
  ten         String
  moTa        String?
  maCode      String          @unique
  idChuNhom   Int
  ngayTao     DateTime        @default(now())

  chuNhom     NguoiDung       @relation("ChuNhom", fields: [idChuNhom], references: [id], onDelete: Cascade)
  thanhViens  ThanhVienNhom[]
  deadlineNhoms DeadlineNhom[]

  @@index([maCode])
  @@index([idChuNhom])
}

model ThanhVienNhom {
  id          Int         @id @default(autoincrement())
  idNhom      Int
  idNguoiDung Int
  vaiTro      String      @default("thanh_vien") // "chu_nhom" | "thanh_vien"
  ngayThamGia DateTime    @default(now())

  nhom        NhomHocTap  @relation(fields: [idNhom], references: [id], onDelete: Cascade)
  nguoiDung   NguoiDung   @relation(fields: [idNguoiDung], references: [id], onDelete: Cascade)

  @@unique([idNhom, idNguoiDung])
  @@index([idNguoiDung])
  @@index([idNhom])
}

model DeadlineNhom {
  id          Int                  @id @default(autoincrement())
  idNhom      Int
  idNguoiTao  Int
  tieuDe      String
  moTa        String?
  hanChot     DateTime
  doUuTien    String               @default("binh_thuong")
  ngayTao     DateTime             @default(now())

  nhom        NhomHocTap           @relation(fields: [idNhom], references: [id], onDelete: Cascade)
  nguoiTao    NguoiDung            @relation("NguoiTaoDeadlineNhom", fields: [idNguoiTao], references: [id], onDelete: Cascade)
  tienDos     TienDoDeadlineNhom[]

  @@index([idNhom])
  @@index([idNhom, hanChot])
}

model TienDoDeadlineNhom {
  id             Int          @id @default(autoincrement())
  idDeadlineNhom Int
  idNguoiDung    Int
  trangThai      String       @default("chua_lam") // "chua_lam" | "dang_lam" | "hoan_thanh"
  ghiChu         String?
  capNhatLuc     DateTime     @default(now()) @updatedAt

  deadlineNhom   DeadlineNhom @relation(fields: [idDeadlineNhom], references: [id], onDelete: Cascade)
  nguoiDung      NguoiDung    @relation(fields: [idNguoiDung], references: [id], onDelete: Cascade)

  @@unique([idDeadlineNhom, idNguoiDung])
  @@index([idNguoiDung])
  @@index([idDeadlineNhom])
}
