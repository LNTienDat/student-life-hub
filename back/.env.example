# === Database ===
DATABASE_URL=postgresql://user:password@localhost:5432/student_life_hub

# === Authentication ===
JWT_SECRET=your_secret_key_here

# === Email (Nodemailer) ===
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=your_email@gmail.com
FRONTEND_URL=http://localhost:5173

# === Google Gemini AI ===
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash

# === Server ===
PORT=5000
NODE_ENV=development
TRUST_PROXY=false

# Render deployment: scripts/render-start.mjs serves front/dist and /api together.
# Leave false for the existing separate local frontend/backend workflow.
SERVE_FRONTEND=false
# Disabled in render.yaml: free Render cannot send SMTP on 465/587.
ENABLE_CRON_JOBS=true

# Exact additional web origins, comma-separated; no wildcards.
# Set to the assigned Static Site URL after creation; retain old frontend URL during migration.
ADDITIONAL_FRONTEND_URLS=
