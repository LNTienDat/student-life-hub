# === BẮT BUỘC ===
DATABASE_URL="postgresql://user:password@localhost:5432/student_life_hub"
JWT_SECRET="thay_bang_chuoi_bi_mat_cua_ban"

# === TÙY CHỌN — email (quên mật khẩu, nhắc deadline) ===
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM="Student Life Hub <your@email.com>"

# === TÙY CHỌN — frontend URL (dùng cho link đặt lại mật khẩu trong email) ===
FRONTEND_URL="http://localhost:5173"

# === TÙY CHỌN — chatbot Gemini ===
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# === TÙY CHỌN — chỉ bật khi deploy sau reverse proxy thật (Render, Railway,
# Heroku, nginx...). KHÔNG bật khi chạy local — sẽ làm rate-limit chống
# brute-force bị vô hiệu hóa vì ai cũng giả mạo IP được. ===
TRUST_PROXY=false
